{#- Email-safe HTML (tables + inline styles). Mirrors apps/web/src/lib/email.ts -#}
{%- set C = {"text":"#111827","muted":"#6b7280","line":"#e5e7eb","bg":"#f5f6f8","card":"#ffffff","accent":"#b7791f","up":"#15803d","down":"#b91c1c"} -%}
{%- macro perf(v, unit) -%}
<span style="color:{{ C.up if v > 0 else (C.down if v < 0 else C.muted) }};font-family:ui-monospace,Menlo,monospace">{{ "%+.0fbp"|format(v) if unit == "pct" else "%+.2f%%"|format(v) }}</span>
{%- endmacro -%}
{%- macro section(n, title, blurb) -%}
<tr><td style="padding:28px 0 8px">
  <div style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:{{ C.accent }};font-weight:700">{{ n }} · {{ title }}</div>
  <div style="font-size:12px;color:{{ C.muted }};margin-top:2px">{{ blurb }}</div>
</td></tr>
{%- endmacro -%}
<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>MacroBrief — {{ as_of.strftime("%A %-d %B %Y") }}</title></head>
<body style="margin:0;background:{{ C.bg }};font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:{{ C.text }}">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:24px 12px">
<table role="presentation" width="720" cellpadding="0" cellspacing="0" style="max-width:720px;width:100%">
  <tr><td style="padding:0 0 12px">
    <table role="presentation" width="100%"><tr>
      <td><div style="display:inline-block;background:#f5b942;color:#0b0e14;font-weight:900;width:28px;height:28px;line-height:28px;text-align:center;border-radius:6px;font-size:16px">M</div>
      <span style="font-weight:700;font-size:16px;margin-left:8px;vertical-align:top;line-height:28px">MacroBrief</span></td>
      <td align="right" style="font-size:11px;color:{{ C.muted }}">US · UK · CN<br>{{ as_of.strftime("%A %-d %B %Y") }} · 06:00 London</td>
    </tr></table>
  </td></tr>
  {% if one_liner %}
  <tr><td style="background:{{ C.card }};border:1px solid {{ C.line }};border-radius:8px;padding:14px 16px;font-size:13px;line-height:1.55">
    <b>Overnight in one line.</b> {{ one_liner }}
    <div style="margin-top:8px;font-size:11px;color:{{ C.muted }}">Open the <a href="{{ dashboard_url }}" style="color:{{ C.accent }}">dashboard</a> for charts, decision-maker views and history.</div>
  </td></tr>
  {% endif %}

  {{ section("01", "Market Summary", "Close, 1D, 5D, MTD, YTD, 52-week range") }}
  <tr><td style="background:{{ C.card }};border:1px solid {{ C.line }};border-radius:8px">
  {% for cls in ["Equities","Rates","FX","Commodities"] %}{% set rows = markets|selectattr("asset_class","equalto",cls)|list %}{% if rows %}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:12px">
      <tr style="background:#fafafa"><td colspan="7" style="padding:8px 12px;font-weight:700;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:{{ C.muted }};border-bottom:1px solid {{ C.line }}">{{ cls }}{% if cls == "Rates" %} <span style="font-weight:400">(yield %, changes bp)</span>{% endif %}</td></tr>
      <tr style="color:{{ C.muted }};font-size:10px;text-transform:uppercase"><td style="padding:6px 12px">Instrument</td><td align="right" style="padding:6px 8px">Close</td><td align="right" style="padding:6px 8px">1D</td><td align="right" style="padding:6px 8px">5D</td><td align="right" style="padding:6px 8px">MTD</td><td align="right" style="padding:6px 8px">YTD</td><td align="right" style="padding:6px 12px">52w lo–hi</td></tr>
      {% for m in rows %}
      <tr style="border-top:1px solid {{ C.line }}">
        <td style="padding:6px 12px"><span style="color:{{ C.muted }};font-size:10px">{{ m.geo }}</span> <a href="{{ m.source_url }}" style="color:{{ C.text }};text-decoration:none;font-weight:600">{{ m.name }}</a></td>
        <td align="right" style="padding:6px 8px;font-family:ui-monospace,Menlo,monospace;font-weight:600">{{ "%.2f%%"|format(m.close) if m.unit == "pct" else "{:,.2f}".format(m.close) }}</td>
        <td align="right" style="padding:6px 8px">{{ perf(m.d1, m.unit) }}</td>
        <td align="right" style="padding:6px 8px">{{ perf(m.d5, m.unit) }}</td>
        <td align="right" style="padding:6px 8px">{{ perf(m.mtd, m.unit) }}</td>
        <td align="right" style="padding:6px 8px">{{ perf(m.ytd, m.unit) }}</td>
        <td align="right" style="padding:6px 12px;color:{{ C.muted }};font-family:ui-monospace,Menlo,monospace;font-size:11px">{{ "{:,.2f}".format(m.lo52) }} – {{ "{:,.2f}".format(m.hi52) }}</td>
      </tr>
      {% endfor %}
    </table>
  {% endif %}{% endfor %}
  </td></tr>

  {{ section("02", "Economic Calendar", "High & medium importance · London time") }}
  <tr><td style="background:{{ C.card }};border:1px solid {{ C.line }};border-radius:8px">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:12px">
    {% for day, evs in calendar_by_day %}
      <tr style="background:#fafafa"><td colspan="4" style="padding:8px 12px;font-weight:700;border-bottom:1px solid {{ C.line }}">{{ day }}</td></tr>
      {% for e in evs %}
      <tr style="border-top:1px solid {{ C.line }}">
        <td style="padding:6px 12px;width:52px;font-family:ui-monospace,Menlo,monospace;color:{{ C.muted }}">{{ e.at|london("%H:%M") }}</td>
        <td style="padding:6px 8px;width:36px"><span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:{{ C.down if e.importance == 'high' else '#d97706' }}"></span> <b style="font-size:10px;color:{{ C.muted }}">{{ e.geo }}</b></td>
        <td style="padding:6px 8px"><a href="{{ e.source_url }}" style="color:{{ C.text }};text-decoration:none;font-weight:600">{{ e.title }}</a> <span style="color:{{ C.muted }};font-size:11px">· {{ e.source }}</span></td>
        <td align="right" style="padding:6px 12px;color:{{ C.muted }};font-size:11px;white-space:nowrap">{% if e.actual %}Act <b style="color:{{ C.text }}">{{ e.actual }}</b> · {% endif %}{% if e.consensus %}Cons <b>{{ e.consensus }}</b>{% endif %}{% if e.previous %} · Prev {{ e.previous }}{% endif %}</td>
      </tr>
      {% endfor %}
    {% endfor %}
    </table>
  </td></tr>

  {{ section("03", "Economic Summary", "Key releases read; one line on outcome, one on consensus") }}
  <tr><td style="background:{{ C.card }};border:1px solid {{ C.line }};border-radius:8px">
    {% for r in releases %}
    <div style="padding:12px;{% if not loop.first %}border-top:1px solid {{ C.line }}{% endif %}">
      <div style="font-size:11px;color:{{ C.muted }}"><b>{{ r.geo }}</b> · {{ r.source_name }} · <span style="color:{{ C.up if r.surprise == 'beat' else (C.down if r.surprise == 'miss' else C.muted) }};font-weight:700">{{ r.surprise|upper }}</span></div>
      <div style="font-size:14px;font-weight:700;margin:2px 0 6px"><a href="{{ r.source_url }}" style="color:{{ C.text }};text-decoration:none">{{ r.title }}</a></div>
      <div style="font-size:12px;line-height:1.5"><b style="color:{{ C.muted }};font-size:10px;text-transform:uppercase;letter-spacing:.06em">Outcome</b> &nbsp;{{ r.outcome }}</div>
      <div style="font-size:12px;line-height:1.5;margin-top:2px"><b style="color:{{ C.muted }};font-size:10px;text-transform:uppercase;letter-spacing:.06em">Consensus</b> &nbsp;{{ r.consensus }}</div>
      <div style="font-size:11px;margin-top:6px"><a href="{{ r.report_url }}" style="color:{{ C.accent }}">Full report →</a></div>
    </div>
    {% else %}<div style="padding:12px;color:{{ C.muted }};font-size:12px">No key releases in the last 48 hours.</div>{% endfor %}
  </td></tr>

  {{ section("04", "Decision Maker Summary", "Central banks, government, treasury, regulators") }}
  <tr><td style="background:{{ C.card }};border:1px solid {{ C.line }};border-radius:8px">
    {% for d in decision_makers %}
    <div style="padding:12px;{% if not loop.first %}border-top:1px solid {{ C.line }}{% endif %}">
      <div style="font-size:11px;color:{{ C.muted }}"><b>{{ d.geo }}</b> · {{ d.institution }} · {{ d.published_at|london("%d %b") }}</div>
      <div style="font-size:13px;font-weight:700;margin:2px 0 4px"><a href="{{ d.url }}" style="color:{{ C.text }};text-decoration:none">{{ d.title }}</a></div>
      {% if d.summary %}<div style="font-size:12px;line-height:1.5;color:#374151">{{ d.summary }}</div>{% endif %}
    </div>
    {% endfor %}
  </td></tr>

  {{ section("05", "Global Summary", "Bloomberg/Economist › FT/WSJ › Reuters/other") }}
  <tr><td style="background:{{ C.card }};border:1px solid {{ C.line }};border-radius:8px">
    {% for tier, label in [(1,"Tier 1 — Bloomberg · Economist"),(2,"Tier 2 — FT · WSJ"),(3,"Tier 3 — Reuters · other")] %}{% set hs = headlines|selectattr("tier","equalto",tier)|list %}{% if hs %}
    <div style="padding:8px 12px;background:#fafafa;border-bottom:1px solid {{ C.line }};font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:{{ C.muted }};font-weight:700">{{ label }}</div>
    {% for h in hs %}
    <div style="padding:10px 12px;border-bottom:1px solid {{ C.line }}">
      <div style="font-size:11px;color:{{ C.muted }}"><b>{{ h.geo }}</b> · {{ h.source }} · {{ h.published_at|london("%H:%M") }}{% if h.access == "title" %} · <i>title only</i>{% endif %}</div>
      <div style="font-size:13px;font-weight:600;margin-top:2px"><a href="{{ h.url }}" style="color:{{ C.text }};text-decoration:none">{{ h.title }}</a></div>
      {% if h.summary %}<div style="font-size:12px;color:#374151;margin-top:2px;line-height:1.5">{{ h.summary }}</div>{% endif %}
    </div>
    {% endfor %}{% endif %}{% endfor %}
  </td></tr>

  <tr><td style="padding:20px 0 0;font-size:11px;color:{{ C.muted }};line-height:1.6">
    Generated {{ generated_at|london("%d %b %Y %H:%M") }} London. Summaries are machine-generated from the linked documents; numbers are quoted from the source, not inferred.<br>
    <a href="{{ dashboard_url }}/settings" style="color:{{ C.muted }}">Manage schedule & recipients</a>
  </td></tr>
</table></td></tr></table>
</body></html>
