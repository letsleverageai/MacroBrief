# --- database ---
# dev: sqlite file; prod: postgresql+psycopg://macrobrief:password@db:5432/macrobrief
DATABASE_URL=sqlite:///data/macrobrief.db

# --- scheduling ---
TIMEZONE=Europe/London
EMAIL_CRON=0 6 * * 1-6
DASHBOARD_REFRESH_CRON=0 9 * * 1-5

# --- delivery ---
EMAIL_FROM=brief@yourdomain.com
EMAIL_TO=analyst@example.com
RESEND_API_KEY=
# or SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DASHBOARD_URL=https://brief.yourdomain.com

# --- data keys (all free tiers) ---
FRED_API_KEY=
BRAVE_API_KEY=
# --- LLM (pick one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-3-5-haiku-latest

# --- internal API auth (web -> pipeline) ---
PIPELINE_TOKEN=change-me-long-random
