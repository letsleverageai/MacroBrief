# ---- edge ----
DOMAIN=brief.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# ---- web auth ----
AUTH_EMAIL=analyst@example.com
# printf 'your-long-passphrase' | shasum -a 256
AUTH_PASSWORD_SHA256=
# 32+ random chars:  openssl rand -base64 48
AUTH_SECRET=
# base32 TOTP secret (scan into Google Authenticator / 1Password):  python3 -c "import base64,os;print(base64.b32encode(os.urandom(20)).decode())"
AUTH_TOTP_SECRET=

# ---- internal ----
PIPELINE_TOKEN=
POSTGRES_PASSWORD=

# ---- pipeline (see pipeline/.env.example for the full list) ----
TIMEZONE=Europe/London
EMAIL_CRON=0 6 * * 1-6
DASHBOARD_REFRESH_CRON=0 9 * * 1-5
EMAIL_FROM=brief@yourdomain.com
EMAIL_TO=analyst@example.com
RESEND_API_KEY=
FRED_API_KEY=
BRAVE_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-haiku-latest
